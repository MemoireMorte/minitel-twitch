# Your Twitch channel name (no #) — required
TWITCH_CHANNEL=your_channel_name

# Port the WebSocket server listens on (ESP32 connects here)
MINITEL_WS_PORT=8080

# How long sub/follow alerts stay on screen (milliseconds)
ALERT_DURATION_MS=4000

# Show full-screen sub/raid alerts (true/false)
ALERTS_ENABLED=true

# Beep the Minitel when an alert shows (true/false)
BELL_ENABLED=true
